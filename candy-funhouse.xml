      <link>https://candyfunhouse.ca/products/mars-halloween-chocolate-variety-50ct-526g</link>
      <description>
      &lt;table border="0"&gt;
  &lt;tr&gt;
    &lt;td width="200"&gt;&lt;img width="200" src="https://cdn.shopify.com/s/files/1/0250/7483/files/mars-halloween-chocolate-variety-50ct-526g-Candy-Funhouse-2026.png?v=1790188540"&gt;&lt;/td&gt;
