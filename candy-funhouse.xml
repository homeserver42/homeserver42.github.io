      <link>https://candyfunhouse.ca/products/cadbury-dairy-milk-hazelnut-creme-105g</link>
      <description>
      &lt;table border="0"&gt;
  &lt;tr&gt;
    &lt;td width="200"&gt;&lt;img width="200" src="https://cdn.shopify.com/s/files/1/0250/7483/files/cadbury-dairy-milk-hazelnut-creme-105g-Candy-Funhouse-2026.png?v=1790188561"&gt;&lt;/td&gt;
    &lt;td valign="bottom"&gt;
